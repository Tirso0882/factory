{
  // Type-checks the factory: `npm run typecheck`. Nothing is emitted: tsx runs
  // the CLI's .mts files (bin/factory.mjs) and `node --test` the tests.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // Node runs the tests by stripping the types, so only erasable syntax.
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  "include": ["**/*.mts"],
  "exclude": ["node_modules", ".sandcastle", ".factory/logs"]
}
