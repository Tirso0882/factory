{
  "name": "@tirso0882/factory",
  "version": "0.1.3",
  "description": "The agent factory: builds ready-for-agent issues into pull requests.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tirso0882/factory.git"
  },
  "bin": {
    "factory": "bin/factory.mjs"
  },
  "exports": {
    ".": "./index.mts"
  },
  "files": [
    "bin/",
    "*.mts",
    "shared/",
    "workflows/",
    "!**/*.test.mts",
    "!shared/fake-host.mts"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "node --test '*.test.mts' 'shared/**/*.test.mts' 'workflows/**/*.test.mts' 'bin/**/*.test.mts'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-hero/sandcastle": "^0.14.0",
    "@types/node": "^24.0.0",
    "@types/semver": "^7.8.0",
    "semver": "^7.8.6",
    "tsx": "^4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@standard-schema/spec": "^1.1.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0"
  }
}
